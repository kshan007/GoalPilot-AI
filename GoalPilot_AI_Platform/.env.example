# GoalPilot AI Platform — environment template
# Copy to `.env` (backend reads it via the process environment) and fill in real values.
# NOTHING in this file is a real secret. Never commit a populated `.env`.

# ---------------------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------------------
GOALPILOT_ENV=development                 # development | production

# ---------------------------------------------------------------------------------------
# Database
# PostgreSQL 17 is the intended production target.
#
#   postgresql+psycopg2://<user>:<password>@<host>:5432/<db>   <- default; psycopg2 driver
#   postgresql+psycopg://...                                   <- requires `pip install "psycopg[binary]"`
#   sqlite:///./goalpilot.db                                   <- zero-setup local / tests
#
# The psycopg2 driver is the default because `psycopg[binary]` could not be imported on the
# development host (libpq not available). See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------------------
# SQLite is the supported target: no server, no credentials, no setup. This is also the default
# when DATABASE_URL is unset, so the line below is documentation rather than a requirement.
DATABASE_URL=sqlite:///./goalpilot.db
# PostgreSQL remains optional for a future deployment (untested against this schema):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/goalpilot

# ---------------------------------------------------------------------------------------
# Authentication
# REQUIRED in production. If unset in development an ephemeral key is generated at startup,
# which means every restart invalidates existing sessions.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------------------
SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
RESET_TOKEN_TTL_MINUTES=30
BCRYPT_ROUNDS=12
# Development only: return the password-reset token in the API response so the flow can be
# demonstrated without a mail server. MUST be false in production.
EXPOSE_RESET_TOKEN=true

# ---------------------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_OPTIMIZE_PER_MINUTE=30

# ---------------------------------------------------------------------------------------
# Research models (read-only)
# Absolute path to the GoalPilot_AI_Completed project. Auto-detected when left blank.
# ---------------------------------------------------------------------------------------
GOALPILOT_RESEARCH_PATH=

# RL inference. Set GOALPILOT_ENABLE_RL=false to disable the RL and hybrid arms entirely;
# they will report 'unavailable' and the comparison will fall back to the LP.
GOALPILOT_ENABLE_RL=true
GOALPILOT_RL_CHECKPOINT=training_logs/experiments/ppo_recommended_v1/archived_v1/seed7/best/best_model.zip

# ---------------------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------------------
FORECAST_MIN_HISTORY_MONTHS=3
GOALPILOT_SERVE_FRONTEND=false            # true to have the API process also serve frontend/dist

# ---------------------------------------------------------------------------------------
# External data providers (all optional; every feature works without credentials)
# ---------------------------------------------------------------------------------------
# false -> serve the bundled, source-annotated snapshots and label every row accordingly.
GOALPILOT_ENABLE_LIVE_PROVIDERS=true
PROVIDER_HTTP_TIMEOUT_SECONDS=12
PROVIDER_CACHE_TTL_SECONDS=21600          # 6 hours
INVESTMENT_SHORTLIST_PER_CATEGORY=2
# Free NAV-history mirror (api.mfapi.in) used only for trailing returns; unofficial, labelled.
GOALPILOT_ENABLE_MFAPI_HISTORY=true

# Rate for a loan category with NO published product. Labelled `estimated_scenario` in every
# response; never presented as a lender rate or an offer.
GOALPILOT_SCENARIO_LOAN_RATE=0.12

# Optional path overrides (auto-detected inside the repository by default)
# GOALPILOT_WALR_DATA_PATH=../datasets/GoalPilot_AI/extracted_features/walr_features.csv
# GOALPILOT_MARKET_DATA_PATH=../datasets/GoalPilot_AI/extracted_features/nifty_monthly_features.csv

# ---------------------------------------------------------------------------------------
# Gemini — the only third-party AI service. Server-side only; never expose to the frontend.
# Leave blank to run entirely on the deterministic explanation fallback.
# ---------------------------------------------------------------------------------------
GEMINI_API_KEY=
GOALPILOT_GEMINI_MODEL=gemini-2.5-flash
GOALPILOT_ENABLE_LLM=true
GEMINI_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------------------
# Frontend (Vite) — put these in frontend/.env
# ---------------------------------------------------------------------------------------
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ---------------------------------------------------------------------------------------
# Gemini tuning (optional). Thinking is the dominant latency cost on 2.5 models; -1 omits the
# field entirely, 0 disables thinking, higher values allow more reasoning.
# ---------------------------------------------------------------------------------------
GOALPILOT_GEMINI_THINKING_BUDGET=0
GOALPILOT_GEMINI_MAX_OUTPUT_TOKENS=3072
