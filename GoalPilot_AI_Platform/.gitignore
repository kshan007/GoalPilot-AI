outputs/
outputs/*.log
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Playwright artefacts: failure traces and screenshots contain synthetic user financial data
test-results/
playwright-report/
blob-report/
.playwright/

